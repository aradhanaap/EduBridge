public class Main {

    static int search(int[] a, int key) {
        for (int i = 0; i < a.length; i++) {
            if (a[i] == key) {
                return i;
            }
        }

        return -1;
    }

    public static void main(String[] args) {

        int[] a = {10, 23, 45, 7, 23, 50};

        int index1 = search(a, 23);
        int index2 = search(a, 7);

        if (index1 != -1) {
            System.out.println("Key 23 found at index " + index1);
        } else {
            System.out.println("Key 23 not found");
        }

        if (index2 != -1) {
            System.out.println("Key 7 found at index " + index2);
        } else {
            System.out.println("Key 7 not found");
        }
    }
}
