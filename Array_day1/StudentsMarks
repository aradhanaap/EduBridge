public class StudentMarks {
    public static void main(String[] args) {

        int[][] marks = {
            {80, 75, 90},
            {60, 85, 70},
            {95, 65, 88}
        };

        // Print matrix and row totals
        System.out.println("Matrix with Student Totals:");

        for (int i = 0; i < marks.length; i++) {
            int rowTotal = 0;

            for (int j = 0; j < marks[i].length; j++) {
                System.out.print(marks[i][j] + "\t");
                rowTotal += marks[i][j];
            }

            System.out.println("Total = " + rowTotal);
        }

        // Calculate and print column totals
        System.out.println("\nSubject Totals:");

        for (int j = 0; j < 3; j++) {
            int columnTotal = 0;

            for (int i = 0; i < 3; i++) {
                columnTotal += marks[i][j];
            }

            System.out.println("Subject " + (j + 1) + " Total = " + columnTotal);
        }
    }
}
