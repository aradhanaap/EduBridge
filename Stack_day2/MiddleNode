class Node {
    int data;
    Node next;

    Node(int data) {
        this.data = data;
        this.next = null;
    }
}

class LinkedList {

    Node head;

    // Insert at the end
    public void insertEnd(int data) {
        Node newNode = new Node(data);

        if (head == null) {
            head = newNode;
            return;
        }

        Node current = head;

        while (current.next != null) {
            current = current.next;
        }

        current.next = newNode;
    }

    // Find middle node using slow and fast pointers
    public Node findMiddle(Node head) {

        Node slow = head;
        Node fast = head;

        while (fast != null && fast.next != null) {
            slow = slow.next;          // Move 1 step
            fast = fast.next.next;     // Move 2 steps
        }

        return slow;
    }
}

public class MiddleNode {
    public static void main(String[] args) {

        // Test with 5 nodes
        LinkedList list1 = new LinkedList();

        list1.insertEnd(10);
        list1.insertEnd(20);
        list1.insertEnd(30);
        list1.insertEnd(40);
        list1.insertEnd(50);

        Node middle1 = list1.findMiddle(list1.head);

        System.out.println("Middle of 5 nodes = " + middle1.data);


        // Test with 6 nodes
        LinkedList list2 = new LinkedList();

        list2.insertEnd(10);
        list2.insertEnd(20);
        list2.insertEnd(30);
        list2.insertEnd(40);
        list2.insertEnd(50);
        list2.insertEnd(60);

        Node middle2 = list2.findMiddle(list2.head);

        System.out.println("Middle of 6 nodes = " + middle2.data);
    }
}
