class Node {
    int data;
    Node next;

    // Constructor
    Node(int data) {
        this.data = data;
        this.next = null;
    }
}

class LinkedList {

    Node head;

    // Insert at the end
    public void insertEnd(int data) {

        Node newNode = new Node(data);

        if (head == null) {
            head = newNode;
            return;
        }

        Node current = head;

        while (current.next != null) {
            current = current.next;
        }

        current.next = newNode;
    }

    // Insert at the front
    public void insertFront(int data) {

        Node newNode = new Node(data);

        newNode.next = head;
        head = newNode;
    }

    // Display the linked list
    public void display() {

        Node current = head;

        while (current != null) {
            System.out.print(current.data + " -> ");
            current = current.next;
        }

        System.out.println("null");
    }

    // Count the number of nodes
    public int count() {

        int count = 0;
        Node current = head;

        while (current != null) {
            count++;
            current = current.next;
        }

        return count;
    }
}

public class LinkedListDemo {

    public static void main(String[] args) {

        LinkedList list = new LinkedList();

        // Insert 20, 30, 40 at the end
        list.insertEnd(20);
        list.insertEnd(30);
        list.insertEnd(40);

        // Insert 10 at the front
        list.insertFront(10);

        // Display the list
        System.out.print("Linked List: ");
        list.display();

        // Print node count
        System.out.println("Node count: " + list.count());
    }
}
