class Shape {
    void describe() {
        System.out.println("This is a shape.");
    }
}

class Square extends Shape {
    int side;

    Square(int side) {
        this.side = side;
    }

    @Override
    void describe() {
        super.describe();  // Calls parent class method
        System.out.println("This is a square with side: " + side);
    }
}

public class Main {
    public static void main(String[] args) {
        Square s = new Square(5);

        s.describe();
    }
}
